# Local sandbox demo. `npm run demo` loads `.env` when that file exists,
# otherwise this file. Copy it with: cp .env.example .env
# Use two different local tokens. Do not put production keys here.

ADMIN_TOKEN=local-admin-token
USER_TOKEN=local-user-token
LOCAL_DEGRADED=1
DEMO_PRINCIPAL=demo:office-user

# Formal config is mutually exclusive with LOCAL_DEGRADED=1.
# PUBLIC_BASE_URL is required there and must be a public https origin.
# Unset LOCAL_DEGRADED, then set for example:
# PUBLIC_BASE_URL=https://your-public-host.example
