# Copy to .env and fill only on a machine that is allowed to hold keys.
# Never commit .env. Empty values keep the demo on sandbox-mock.

# sandbox-mock | alipay-sandbox | alipay-live
# sandbox-mock needs no keys and is the PAYATHON walkthrough path.
# alipay-sandbox / alipay-live are used only when the three keys below are set.
# If those modes are requested without keys, the server stays on sandbox-mock.
PAY_MODE=sandbox-mock

PORT=3780

# Alipay Open Platform application id (sandbox or production).
ALIPAY_APP_ID=

# Merchant application private key, PKCS#8 or PKCS#1 PEM.
# One line is fine: use \n between PEM lines inside double quotes.
ALIPAY_PRIVATE_KEY=

# Alipay public key (not the application public key), PEM or bare base64.
ALIPAY_ALIPAY_PUBLIC_KEY=

# Optional. Defaults follow PAY_MODE.
# Sandbox: https://openapi-sandbox.dl.alipaydev.com/gateway.do
# Live:    https://openapi.alipay.com/gateway.do
ALIPAY_GATEWAY=

# Public HTTPS endpoints. Required before a real notify can be trusted.
# The demo does not treat the browser return URL as payment success.
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=

# JSON file for orders, entitlements, and buyout archives. Gitignored.
DATA_PATH=data/store.json
